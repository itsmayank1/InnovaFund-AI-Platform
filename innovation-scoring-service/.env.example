# Innovation Scoring Service Environment Configuration

# Service Execution Mode
STANDALONE=true
AUTH_REQUIRED=false

# Database Connection (Defaults to zero-setup SQLite)
DATABASE_URL=sqlite:///./innovation_scoring.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5433/funding_innovation_platform

# Signal Resolution Mode ('local' | 'heuristic' | 'http')
SIGNAL_SOURCE=local

# External Microservice Integrations (Used when SIGNAL_SOURCE=http)
PATENT_API_URL=http://localhost:8000/api/patents
TECH_API_URL=http://localhost:8000/api/technology
HTTP_PROVIDER_TIMEOUT_SECONDS=3.0

# Tunable Heuristic Bounds
MAX_CITATIONS=500.0
MAX_CLAIMS=50.0
MAX_FAMILY_SIZE=20.0
MAX_FILING_YEARS=20.0

# Server Host & Port
HOST=0.0.0.0
PORT=8004
